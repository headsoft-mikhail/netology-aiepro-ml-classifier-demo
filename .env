# PipelineSettings: префикс PIPELINE_.
PIPELINE_SOURCE_URL=https://archive.ics.uci.edu/static/public/193/cardiotocography.zip
PIPELINE_WORKBOOK_FILENAME=CTG.xls
PIPELINE_TIMEOUT=60
PIPELINE_RANDOM_STATE=42
PIPELINE_N_JOBS=-1
PIPELINE_EXPERIMENT_NAME=classical_pipeline

# Порты локальных инструментов; .env загружается при запуске через just.
MLFLOW_PORT=5001
JUPYTER_PORT=5002
AIRFLOW_PORT=5003

# RandomForestSettings

# Исходная модель для обеих целей.
RANDOM_FOREST_BASELINE__N_ESTIMATORS=200
RANDOM_FOREST_BASELINE__MAX_DEPTH=None
RANDOM_FOREST_BASELINE__MIN_SAMPLES_SPLIT=2
RANDOM_FOREST_BASELINE__MIN_SAMPLES_LEAF=1
RANDOM_FOREST_BASELINE__MAX_FEATURES=sqrt
RANDOM_FOREST_BASELINE__CLASS_WEIGHT=None

# Выбранная модель CLASS.
RANDOM_FOREST_CLASS_PARAMETERS__N_ESTIMATORS=100
RANDOM_FOREST_CLASS_PARAMETERS__MAX_DEPTH=12
RANDOM_FOREST_CLASS_PARAMETERS__MIN_SAMPLES_SPLIT=8
RANDOM_FOREST_CLASS_PARAMETERS__MIN_SAMPLES_LEAF=1
RANDOM_FOREST_CLASS_PARAMETERS__MAX_FEATURES=0.5
RANDOM_FOREST_CLASS_PARAMETERS__CLASS_WEIGHT=balanced

# Выбранная модель NSP.
RANDOM_FOREST_NSP_PARAMETERS__N_ESTIMATORS=350
RANDOM_FOREST_NSP_PARAMETERS__MAX_DEPTH=16
RANDOM_FOREST_NSP_PARAMETERS__MIN_SAMPLES_SPLIT=3
RANDOM_FOREST_NSP_PARAMETERS__MIN_SAMPLES_LEAF=1
RANDOM_FOREST_NSP_PARAMETERS__MAX_FEATURES=log2
RANDOM_FOREST_NSP_PARAMETERS__CLASS_WEIGHT=balanced

# ExperimentSettings: префикс EXPERIMENT_, затем имя поля.
EXPERIMENT_WORKBOOK_FILENAME=CTG.xls
EXPERIMENT_RANDOM_STATE=42

# Число попыток Optuna: первый этап на каждую модель и цель; уточнение на каждую цель.
EXPERIMENT_CLASSICAL_OPTUNA_BUDGET_STAGE_1=25
EXPERIMENT_CLASSICAL_OPTUNA_BUDGET_STAGE_2=50
EXPERIMENT_CLASSICAL_N_JOBS=-1
EXPERIMENT_CLASSICAL_SEARCH_MAX_ITER=20000
EXPERIMENT_CLASSICAL_MLFLOW_EXPERIMENT_NAME=classical_classifiers

# Начальная MLP и подбор её параметров.
EXPERIMENT_NEURAL_BATCH_SIZE=32
EXPERIMENT_NEURAL_HIDDEN_SIZE=32
EXPERIMENT_NEURAL_LEARNING_RATE=0.001
EXPERIMENT_NEURAL_MAX_EPOCHS=50
EXPERIMENT_NEURAL_PATIENCE=10
EXPERIMENT_NEURAL_OPTUNA_BUDGET=25
EXPERIMENT_NEURAL_SEARCH_MAX_EPOCHS=150
EXPERIMENT_NEURAL_SEARCH_PATIENCE=20
EXPERIMENT_NEURAL_MLFLOW_EXPERIMENT_NAME=neural_classifiers

# APISettings: адрес, порт и уровень логирования сервиса.
API_HOST=0.0.0.0
API_PORT=8001
API_LOG_LEVEL=info

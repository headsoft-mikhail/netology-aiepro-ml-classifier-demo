FROM ghcr.io/astral-sh/uv:0.12.15 AS uv
FROM python:3.14.7-slim

RUN apt-get update && apt-get install -y --no-install-recommends curl && rm -rf /var/lib/apt/lists/*

COPY --from=uv /uv /usr/local/bin/uv
ENV UV_PROJECT_ENVIRONMENT=/opt/project/.venv UV_PYTHON_DOWNLOADS=never \
    PATH=/opt/project/.venv/bin:$PATH \
    AIRFLOW_HOME=/opt/airflow \
    AIRFLOW__CORE__LOAD_EXAMPLES=false \
    AIRFLOW__CORE__DAGS_FOLDER=/opt/project/src/classifier/pipeline \
    AIRFLOW__CORE__SIMPLE_AUTH_MANAGER_ALL_ADMINS=true \
    PYTHONPATH=/opt/project/src \
    MLFLOW_HOST=host.docker.internal \
    NO_PROXY=localhost,127.0.0.1,host.docker.internal \
    no_proxy=localhost,127.0.0.1,host.docker.internal
WORKDIR /opt/project
COPY pyproject.toml uv.lock ./
RUN uv sync --frozen --no-install-project --no-dev --group data --group tracking --group orchestration
COPY src ./src
CMD ["airflow", "standalone"]

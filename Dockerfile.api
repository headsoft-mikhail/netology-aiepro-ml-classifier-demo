FROM ghcr.io/astral-sh/uv:0.12.15 AS uv
FROM python:3.14.7-slim

COPY --from=uv /uv /usr/local/bin/uv
ENV UV_PROJECT_ENVIRONMENT=/opt/project/.venv UV_PYTHON_DOWNLOADS=never \
    PATH=/opt/project/.venv/bin:$PATH PYTHONPATH=/opt/project/src
WORKDIR /opt/project
COPY pyproject.toml uv.lock ./
RUN uv sync --frozen --no-install-project --no-dev --group service
COPY src ./src
CMD ["python", "-m", "classifier.api"]
